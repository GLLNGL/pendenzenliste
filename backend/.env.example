# Kopiere diese Datei zu ".env" (im selben Ordner) und trage deine echten SMTP-Zugangsdaten ein.
# Die ".env"-Datei bleibt lokal auf diesem Rechner und wird nicht in Git eingecheckt.
#
# Beispiel Outlook/Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=deine.adresse@outlook.com
#   SMTP_PASS=dein-passwort-oder-app-passwort
#   SMTP_FROM=deine.adresse@outlook.com
#
# Beispiel Gmail (benoetigt ein "App-Passwort", nicht das normale Google-Passwort):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
